{
  "info": {
    "_postman_id": "4a7f0bb0-94a4-47f7-a4aa-83a76a9f7aa1",
    "name": "AMS Client Asset Certificates Regression",
    "description": "Focused client portal API regression for project-assigned assets, component category visibility, certificate metadata, and access suspension.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "runSuffix", "value": "" },
    { "key": "token", "value": "" },
    { "key": "client_token", "value": "" },
    { "key": "client_user_id", "value": "" },
    { "key": "project_id", "value": "" },
    { "key": "access_id", "value": "" },
    { "key": "main_category_id", "value": "" },
    { "key": "category_id", "value": "" },
    { "key": "test_id", "value": "" },
    { "key": "asset_id", "value": "" },
    { "key": "component_id", "value": "" },
    { "key": "certificate_id", "value": "" },
    { "key": "clientEmail", "value": "" },
    { "key": "clientPassword", "value": "ClientPortal123!" },
    { "key": "projectName", "value": "" },
    { "key": "assetName", "value": "" },
    { "key": "componentName", "value": "" },
    { "key": "mainCategoryName", "value": "" },
    { "key": "categoryName", "value": "" },
    { "key": "certificateName", "value": "" },
    { "key": "assetPhoto", "value": "https://example.com/assets/client-portal-asset.png" },
    { "key": "assetDatasheet", "value": "https://example.com/assets/client-portal-datasheet.pdf" },
    { "key": "issueDate", "value": "" },
    { "key": "expiryDate", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const suffix = pm.collectionVariables.get('runSuffix') || Date.now().toString();",
          "pm.collectionVariables.set('runSuffix', suffix);",
          "pm.collectionVariables.set('clientEmail', `client.portal.${suffix}@example.com`);",
          "pm.collectionVariables.set('projectName', `Client Portal Project ${suffix}`);",
          "pm.collectionVariables.set('assetName', `Client Portal Asset ${suffix}`);",
          "pm.collectionVariables.set('componentName', `Client Portal Component ${suffix}`);",
          "pm.collectionVariables.set('mainCategoryName', `Client Portal Main ${suffix}`);",
          "pm.collectionVariables.set('categoryName', `Client Portal Category ${suffix}`);",
          "pm.collectionVariables.set('certificateName', `Client Portal Certificate ${suffix}`);",
          "const now = new Date();",
          "const issue = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() - 1));",
          "const expiry = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 180));",
          "pm.collectionVariables.set('issueDate', issue.toISOString());",
          "pm.collectionVariables.set('expiryDate', expiry.toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Login Admin",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('admin login succeeds', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.token).to.be.a('string').and.not.empty;",
            "  pm.collectionVariables.set('token', body.token);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "02 Create Client User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Client\",\n  \"last_name\": \"Portal\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\",\n  \"role\": \"CLIENT\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/user"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('client user is created active', function () {",
            "  pm.response.to.have.status(201);",
            "  const user = pm.response.json();",
            "  pm.expect(user.user_id).to.match(/^[0-9a-f-]{36}$/i);",
            "  pm.expect(user.email).to.eql(pm.collectionVariables.get('clientEmail'));",
            "  pm.expect(user.role).to.eql('CLIENT');",
            "  pm.expect(user.status).to.eql('ACTIVE');",
            "  pm.collectionVariables.set('client_user_id', user.user_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "03 Create Project",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_name\": \"{{projectName}}\",\n  \"description\": \"Client portal regression project\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/project"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('project is created active', function () {",
            "  pm.response.to.have.status(201);",
            "  const project = pm.response.json();",
            "  pm.expect(project.project_id).to.match(/^[0-9a-f-]{36}$/i);",
            "  pm.expect(project.project_name).to.eql(pm.collectionVariables.get('projectName'));",
            "  pm.collectionVariables.set('project_id', project.project_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "04 Grant Client Project Access",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/user/{{client_user_id}}/project-access"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('client project access is active', function () {",
            "  pm.response.to.have.status(200);",
            "  const access = pm.response.json();",
            "  pm.expect(access.access_id).to.match(/^[0-9a-f-]{36}$/i);",
            "  pm.expect(access.status).to.eql('ACTIVE');",
            "  pm.collectionVariables.set('access_id', access.access_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "05 Create Catalog Main Category",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"main_category_name\": \"{{mainCategoryName}}\",\n  \"description\": \"Client portal regression main category\",\n  \"sort_order\": 10101\n}"
        },
        "url": "{{baseUrl}}/main-category"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('main category is created', function () {",
            "  pm.response.to.have.status(201);",
            "  const mainCategory = pm.response.json();",
            "  pm.expect(mainCategory.main_category_name).to.eql(pm.collectionVariables.get('mainCategoryName'));",
            "  pm.collectionVariables.set('main_category_id', mainCategory.main_category_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "06 Create Category",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"main_category_id\": \"{{main_category_id}}\",\n  \"category_name\": \"{{categoryName}}\",\n  \"description\": \"Client portal regression category\",\n  \"sort_order\": 10102\n}"
        },
        "url": "{{baseUrl}}/category"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('category is linked to main category', function () {",
            "  pm.response.to.have.status(201);",
            "  const category = pm.response.json();",
            "  pm.expect(category.category_name).to.eql(pm.collectionVariables.get('categoryName'));",
            "  pm.expect(category.main_category_id).to.eql(pm.collectionVariables.get('main_category_id'));",
            "  pm.collectionVariables.set('category_id', category.category_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "07 Create Certificate Type",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"test_name\": \"{{certificateName}}\",\n  \"validity_duration\": 6,\n  \"description\": \"Client portal regression certificate type\"\n}"
        },
        "url": "{{baseUrl}}/test-type"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('certificate type is created', function () {",
            "  pm.response.to.have.status(201);",
            "  const testType = pm.response.json();",
            "  pm.expect(testType.test_name).to.eql(pm.collectionVariables.get('certificateName'));",
            "  pm.expect(testType.validity_duration).to.eql(6);",
            "  pm.collectionVariables.set('test_id', testType.test_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "08 Create Assigned Asset",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{assetName}}\",\n  \"photo\": \"{{assetPhoto}}\",\n  \"datasheet\": \"{{assetDatasheet}}\",\n  \"description\": \"Client portal regression asset\",\n  \"status\": \"ACTIVE\",\n  \"location\": \"Client Portal Yard\",\n  \"assigned_project\": \"{{projectName}}\",\n  \"maintenance_interval_hours\": 0\n}"
        },
        "url": "{{baseUrl}}/asset"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('asset is assigned to the active project', function () {",
            "  pm.response.to.have.status(201);",
            "  const asset = pm.response.json();",
            "  pm.expect(asset.asset_id).to.match(/^[0-9a-f-]{36}$/i);",
            "  pm.expect(asset.assigned_project).to.eql(pm.collectionVariables.get('projectName'));",
            "  pm.expect(asset.photo).to.eql(pm.collectionVariables.get('assetPhoto'));",
            "  pm.expect(asset.datasheet).to.eql(pm.collectionVariables.get('assetDatasheet'));",
            "  pm.collectionVariables.set('asset_id', asset.asset_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "09 Create Component",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asset_id\": \"{{asset_id}}\",\n  \"category_id\": \"{{category_id}}\",\n  \"name\": \"{{componentName}}\",\n  \"serial_number\": \"CP-REG-001\",\n  \"manufacturer\": \"Regression Manufacturer\",\n  \"description\": \"Client portal component\",\n  \"location\": \"Client Portal Yard\",\n  \"assigned_project\": \"{{projectName}}\",\n  \"equipment_type\": \"Portal Equipment\",\n  \"structure\": \"Portable\",\n  \"model\": \"CP-1\",\n  \"class\": \"A\",\n  \"class_code\": \"A1\",\n  \"safety_critical\": \"YES\"\n}"
        },
        "url": "{{baseUrl}}/component"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('component is created with category linkage', function () {",
            "  pm.response.to.have.status(201);",
            "  const component = pm.response.json();",
            "  pm.expect(component.name).to.eql(pm.collectionVariables.get('componentName'));",
            "  pm.expect(component.category_id).to.eql(pm.collectionVariables.get('category_id'));",
            "  pm.collectionVariables.set('component_id', component.component_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "10 Create Certificate",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"component_id\": \"{{component_id}}\",\n  \"certificate_name\": \"{{certificateName}}\",\n  \"issue_date\": \"{{issueDate}}\",\n  \"expiry_date\": \"{{expiryDate}}\",\n  \"issuing_authority\": \"Regression Authority\",\n  \"test_id\": \"{{test_id}}\",\n  \"imca_ref\": \"IMCA-REG\",\n  \"imca_d018\": \"D018-REG\",\n  \"maintenance_notes\": \"Client portal certificate\"\n}"
        },
        "url": "{{baseUrl}}/certificate"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('certificate is created valid and linked to component', function () {",
            "  pm.response.to.have.status(201);",
            "  const certificate = pm.response.json();",
            "  pm.expect(certificate.certificate_name).to.eql(pm.collectionVariables.get('certificateName'));",
            "  pm.expect(certificate.component_id).to.eql(pm.collectionVariables.get('component_id'));",
            "  pm.expect(certificate.status).to.eql('VALID');",
            "  pm.collectionVariables.set('certificate_id', certificate.certificate_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "11 Login Client",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('client login succeeds with client role', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.role).to.eql('CLIENT');",
            "  pm.expect(body.status).to.eql('ACTIVE');",
            "  pm.collectionVariables.set('client_token', body.token);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "12 Client Lists Assigned Assets",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{client_token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/client/assets?page=1&limit=20"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('client sees only assigned active project asset', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.data).to.be.an('array').with.length(1);",
            "  pm.expect(body.data[0].asset_id).to.eql(pm.collectionVariables.get('asset_id'));",
            "  pm.expect(body.data[0].photo).to.eql(pm.collectionVariables.get('assetPhoto'));",
            "  pm.expect(body.data[0].datasheet).to.eql(pm.collectionVariables.get('assetDatasheet'));",
            "});"
          ]
        }
      }]
    },
    {
      "name": "13 Client Reads Asset Detail",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{client_token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/client/asset/{{asset_id}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('client detail includes component categories and certificate metadata', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.asset.asset_id).to.eql(pm.collectionVariables.get('asset_id'));",
            "  pm.expect(body.components).to.be.an('array').with.length(1);",
            "  pm.expect(body.components[0].name).to.eql(pm.collectionVariables.get('componentName'));",
            "  pm.expect(body.components[0].main_category_name).to.eql(pm.collectionVariables.get('mainCategoryName'));",
            "  pm.expect(body.components[0].category_name).to.eql(pm.collectionVariables.get('categoryName'));",
            "  pm.expect(body.components[0].serial_number).to.eql('CP-REG-001');",
            "  pm.expect(body.certificates).to.be.an('array').with.length(1);",
            "  pm.expect(body.certificates[0].certificate_name).to.eql(pm.collectionVariables.get('certificateName'));",
            "  pm.expect(body.certificates[0].status).to.eql('VALID');",
            "  pm.expect(body.certificates[0].test_period_months).to.eql(6);",
            "  pm.expect(body.certificates[0].has_file).to.eql(false);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "14 Client Cannot Use Staff Asset API",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{client_token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/assets?page=1&limit=20"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('client is blocked from staff assets API', function () {",
            "  pm.response.to.have.status(403);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "15 Client Certificate File Requires Uploaded File",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{client_token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/client/certificate/{{certificate_id}}/file"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('client file URL is not generated when no file exists', function () {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.eql('certificate file not found');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "16 Suspend Client Project Access",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"status\": \"SUSPENDED\"\n}"
        },
        "url": "{{baseUrl}}/user-project-access/{{access_id}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('admin can suspend project access', function () {",
            "  pm.response.to.have.status(200);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "17 Suspended Access Hides Client Assets",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{client_token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/client/assets?page=1&limit=20"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('suspended access removes client asset visibility', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.data).to.be.an('array').with.length(0);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "18 Delete Regression Asset",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/asset/{{asset_id}}" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('asset cleanup succeeds', function () {",
            "  pm.expect([200, 404]).to.include(pm.response.code);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "19 Delete Regression Client",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/user/{{client_user_id}}" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('client cleanup succeeds', function () {",
            "  pm.expect([200, 404]).to.include(pm.response.code);",
            "});"
          ]
        }
      }]
    }
  ]
}
