{
  "info": {
    "name": "Shared AMS Work Orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18082/v1"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) pm.execution.setNextRequest(null);",
              "pm.collectionVariables.set(\"token\", pm.response.json().token);",
              "pm.collectionVariables.set(\"sortOrder\", Math.floor(Date.now() / 1000));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create equipment type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/equipment-type",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipment_type_name\": \"Shared kind {{$guid}}\",\n  \"sort_order\": {{sortOrder}},\n  \"description\": \"Shared work order fixture\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) pm.execution.setNextRequest(null);",
              "pm.collectionVariables.set(\"kind\", pm.response.json().equipment_type_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create test type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/test-type",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"test_name\": \"Work order inspection {{$guid}}\",\n  \"validity_duration\": 12,\n  \"description\": \"Required test\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) pm.execution.setNextRequest(null);",
              "pm.collectionVariables.set(\"test\", pm.response.json().test_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create standalone equipment and pending certificate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/asset",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Shared equipment {{$guid}}\",\n  \"status\": \"ACTIVE\",\n  \"asset_kind\": \"SINGLE_EQUIPMENT\",\n  \"single_equipment\": {\n    \"equipment_type_id\": \"{{kind}}\",\n    \"test_type_ids\": [\n      \"{{test}}\"\n    ]\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) pm.execution.setNextRequest(null);",
              "pm.collectionVariables.set(\"asset\", pm.response.json().asset_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Raise a maintenance order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/maintenance/work-orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"asset_id\": \"{{asset}}\",\n  \"title\": \"Replace fitting\",\n  \"description\": \"Damaged fitting\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) pm.execution.setNextRequest(null);",
              "pm.collectionVariables.set(\"repair\", pm.response.json().work_order_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List both work types",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/maintenance/work-orders?asset_id={{asset}}&open_only=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) pm.execution.setNextRequest(null);",
              "pm.test(\"Both orders are returned\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.meta.total).to.equal(2);",
              "  pm.expect(body.data.map(row => row.work_type)).to.have.members([\"INSPECTION\", \"MAINTENANCE\"]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter and read initial inspection order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/maintenance/work-orders?asset_id={{asset}}&type=INSPECTION"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) pm.execution.setNextRequest(null);",
              "pm.test(\"Initial inspection is open with a linked certificate and no scheduled date\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.meta.total).to.equal(1);",
              "  const order = body.data[0];",
              "  pm.expect(order.status).to.equal(\"OPEN\");",
              "  pm.expect(order.certificate_id).to.be.a(\"string\");",
              "  pm.expect(order.due_date).to.equal(null);",
              "  pm.expect(order.assignee_id).to.equal(null);",
              "  pm.collectionVariables.set(\"inspection\", order.work_order_id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Start inspection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/maintenance/work-orders/{{inspection}}/start"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) pm.execution.setNextRequest(null);",
              "pm.test(\"Status updates\", () => pm.expect(pm.response.json().status).to.equal(\"IN_PROGRESS\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject manual inspection completion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/maintenance/work-orders/{{inspection}}/complete",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Tested\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "if (pm.response.code !== 409) pm.execution.setNextRequest(null);"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify maintenance remains separately actionable",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/maintenance/work-orders?asset_id={{asset}}&type=MAINTENANCE"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) pm.execution.setNextRequest(null);",
              "pm.test(\"Only maintenance is returned\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.meta.total).to.equal(1);",
              "  pm.expect(body.data[0].work_order_id).to.equal(pm.collectionVariables.get(\"repair\"));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
