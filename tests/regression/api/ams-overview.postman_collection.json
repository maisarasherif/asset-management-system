            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); return; }",
              "pm.collectionVariables.set(\"previousTag\", pm.response.json().quarantine_id);"
            ]
