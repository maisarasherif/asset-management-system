{
  "info": {
    "name": "AMS Overview",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18082/v1"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sign in and set Dubai dates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); return; }",
              "pm.collectionVariables.set(\"token\", pm.response.json().token);",
              "pm.collectionVariables.set(\"sortOrder\", Math.floor(Date.now() / 1000));",
              "const dubaiNow = Date.now() + 4 * 60 * 60 * 1000;",
              "for (const [key, offset] of Object.entries({ issue: -90, previous: -2, yesterday: -1, today: 0, day30: 30, day31: 31 })) {",
              "  pm.collectionVariables.set(key, new Date(dubaiNow + offset * 86400000).toISOString().slice(0, 10));",
              "}"
            ]
          }
        }
      ]
    },
