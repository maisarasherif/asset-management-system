          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/maintenance/work-orders?asset_id={{asset}}&open_only=true&type=MAINTENANCE&page=1&limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Matches, totals and page 1\", () => {",
              "  const result = pm.response.json();",
              "  pm.expect(result.meta).to.include({ page: 1, total: 5, total_pages: 1 });",
              "  pm.expect(result.data.map(order => order.title)).to.have.members([\"Overdue maintenance\",\"Service due today\",\"Beyond thirty days\",\"Meter-based job\",\"Undated repair\"]);",
              "  pm.expect(result.data.map(order => order.work_type)).to.have.members([\"MAINTENANCE\",\"MAINTENANCE\",\"MAINTENANCE\",\"MAINTENANCE\",\"MAINTENANCE\"]);",
              "});"
