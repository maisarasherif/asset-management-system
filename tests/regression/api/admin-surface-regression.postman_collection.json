{
  "info": {
    "_postman_id": "73e7e3a8-9a54-4e41-b551-8bf27a8c6a71",
    "name": "AMS Admin Surface Regression",
    "description": "Newman regression for current admin-only surfaces that support the Cloudscape Administration, Client access, Catalog equipment, and Scheduler management screens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/v1" },
    { "key": "adminEmail", "value": "YOUR_ADMIN_EMAIL" },
    { "key": "adminPassword", "value": "YOUR_ADMIN_PASSWORD" },
    { "key": "runSuffix", "value": "" },
    { "key": "token", "value": "" },
    { "key": "clientEmail", "value": "" },
    { "key": "clientPassword", "value": "" },
    { "key": "client_user_id", "value": "" },
    { "key": "project_id", "value": "" },
    { "key": "access_id", "value": "" },
    { "key": "competency_category_id", "value": "" },
    { "key": "competent_person_id", "value": "" },
    { "key": "equipment_type_id", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const suffix = pm.collectionVariables.get('runSuffix') || Date.now().toString();",
          "pm.collectionVariables.set('runSuffix', suffix);",
          "pm.collectionVariables.set('clientEmail', `newman-admin-surface-client-${suffix}@example.com`);",
          "pm.collectionVariables.set('clientPassword', `ClientSurface-${suffix}`);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Login Admin",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('admin login succeeds', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.token).to.be.a('string').and.not.empty;",
            "  pm.expect(body.role).to.eql('SUPER_ADMIN');",
            "  pm.collectionVariables.set('token', body.token);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "02 Create Client User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"AdminSurface\",\n  \"last_name\": \"Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\",\n  \"role\": \"CLIENT\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/user"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('client user is created', function () {",
            "  pm.response.to.have.status(201);",
            "  const body = pm.response.json();",
            "  pm.expect(body.user_id).to.match(/^[0-9a-f-]{36}$/i);",
            "  pm.collectionVariables.set('client_user_id', body.user_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "03 Create Project",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_name\": \"Newman Admin Surface Project {{runSuffix}}\",\n  \"description\": \"Created by Newman for admin surface regression.\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/project"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('project is created', function () {",
            "  pm.response.to.have.status(201);",
            "  const body = pm.response.json();",
            "  pm.expect(body.project_id).to.match(/^[0-9a-f-]{36}$/i);",
            "  pm.collectionVariables.set('project_id', body.project_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "04 List Projects",
      "request": { "method": "GET", "url": "{{baseUrl}}/projects" },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('projects list is available', function () {",
          "  pm.response.to.have.status(200);",
          "  pm.expect(pm.response.json()).to.be.an('array');",
          "});"
        ] }
