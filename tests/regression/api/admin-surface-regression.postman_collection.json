      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('project update succeeds', function () { pm.response.to.have.status(200); });"
        ] }
      }]
    },
    {
      "name": "06 Grant Client Project Access",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/user/{{client_user_id}}/project-access"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
	          "exec": [
	            "pm.test('project access is granted', function () {",
	            "  pm.response.to.have.status(200);",
	            "  const body = pm.response.json();",
	            "  pm.expect(body.access_id).to.match(/^[0-9a-f-]{36}$/i);",
	            "  pm.expect(body.status).to.eql('ACTIVE');",
	            "  pm.collectionVariables.set('access_id', body.access_id);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "07 List User Project Access",
      "request": { "method": "GET", "url": "{{baseUrl}}/user-project-access" },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
	          "pm.test('project access list includes records', function () {",
	          "  pm.response.to.have.status(200);",
	          "  const rows = pm.response.json();",
	          "  pm.expect(rows).to.be.an('array');",
	          "  const match = rows.find((row) => row.user_id === pm.collectionVariables.get('client_user_id') && row.project_id === pm.collectionVariables.get('project_id'));",
	          "  pm.expect(match, 'created client/project access row').to.exist;",
	          "  pm.collectionVariables.set('access_id', match.access_id);",
	          "});"
	        ] }
	      }]
    },
    {
      "name": "08 Suspend User Project Access",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"status\": \"SUSPENDED\"\n}"
