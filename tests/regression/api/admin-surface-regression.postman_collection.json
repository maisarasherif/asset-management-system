      "name": "05 Update Project",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_name\": \"Newman Admin Surface Project Updated {{runSuffix}}\",\n  \"description\": \"Updated by Newman for admin surface regression.\",\n  \"status\": \"ACTIVE\"\n}"
        },
